{
  // :not([mini]) so these never reach a find field or a commit box, matching
  // tasklist-tools. The handlers act on the file the grammar belongs to.
  "lumine-text-editor[data-grammar~=\"typst\"]:not([mini])": {
    "f5": "typst-tools:compile",
    "alt-f5": "typst-tools:watch",
    "ctrl-f5": "typst-tools:interrupt",
    "f6": "typst-tools:clean-linter",
    "ctrl-f6": "typst-tools:interrupt-all",
    "f7": "typst-tools:open-pdf"
  },
  ".typst-tools-observed-files-list lumine-text-editor[mini]": {
    "cmdorctrl-d": "typst-tools:unobserve-selected-file",
    "alt-enter": "typst-tools:open",
    "ctrl-alt-enter": "typst-tools:open-external",
    "alt-shift-enter": "typst-tools:show-in-folder"
  }
}
