{
  "name": "typst-tools",
  "author": "lumine-code",
  "description": "Compile Typst documents with the typst CLI and view PDFs.",
  "repository": "https://github.com/lumine-code/typst-tools",
  "bugs": {
    "url": "https://github.com/lumine-code/typst-tools/issues"
  },
  "keywords": [
    "typesetting",
    "pdf",
    "compile",
    "watch",
    "build"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "specPackages": [
    "tasks",
    "linter",
    "launcher",
    "open-external"
  ],
  "files": [
    "bin",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "pdf-view.build-provider": {
      "versions": {
        "1.0.0": "providePdfBuildProvider"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "tasks": {
      "versions": {
        "^1.0.0": "consumeTasks"
      }
    }
  },
  "configSchema": {
    "typstPath": {
      "title": "Path to Typst",
      "description": "Path to the typst executable. Leave as 'typst' to use bundled or PATH binary.",
      "type": "string",
      "default": "typst"
    },
    "outputFormat": {
      "title": "Output Format",
      "description": "The output format for compilation.",
      "type": "string",
      "enum": [
        {
          "value": "pdf",
          "description": "PDF - Portable Document Format"
        },
        {
          "value": "png",
          "description": "PNG - Raster image"
        },
        {
          "value": "svg",
          "description": "SVG - Scalable Vector Graphics"
        }
      ],
      "default": "pdf"
    },
    "fontPaths": {
      "title": "Additional Font Paths",
      "description": "Additional directories to search for fonts.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "additionalArgs": {
      "title": "Additional Arguments",
      "description": "Additional command-line arguments passed to typst compile/watch.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "debug": {
      "title": "Debug Mode",
      "description": "Log debug info to developer console (View > Developer > Toggle Developer Tools).",
      "type": "boolean",
      "default": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
