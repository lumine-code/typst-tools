{
  "name": "typst-tools",
  "author": "lumine-code",
  "description": "Compile Typst documents with build tools, compile-on-save, and PDF viewer integration",
  "repository": "https://github.com/lumine-code/typst-tools",
  "bugs": {
    "url": "https://github.com/lumine-code/typst-tools/issues"
  },
  "keywords": [
    "typst",
    "typ",
    "typesetting",
    "pdf",
    "compile",
    "watch"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../typst-tools/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "typst-tools": {
      "versions": {
        "1.0.0": "provideTypstTools"
      }
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    },
    "linter-indie": {
      "versions": {
        "^1.0.0": "consumeIndie"
      }
    }
  },
  "configSchema": {
    "typstPath": {
      "title": "Path to Typst",
      "description": "Path to the typst executable. Leave as 'typst' to use bundled or PATH binary.",
      "type": "string",
      "default": "typst"
    },
    "outputFormat": {
      "title": "Output Format",
      "description": "The output format for compilation.",
      "type": "string",
      "enum": [
        {
          "value": "pdf",
          "description": "PDF - Portable Document Format"
        },
        {
          "value": "png",
          "description": "PNG - Raster image"
        },
        {
          "value": "svg",
          "description": "SVG - Scalable Vector Graphics"
        }
      ],
      "default": "pdf"
    },
    "fontPaths": {
      "title": "Additional Font Paths",
      "description": "Additional directories to search for fonts.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "additionalArgs": {
      "title": "Additional Arguments",
      "description": "Additional command-line arguments passed to typst compile/watch.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "debug": {
      "title": "Debug Mode",
      "description": "Log debug info to developer console (View > Developer > Toggle Developer Tools).",
      "type": "boolean",
      "default": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
